# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deal_finder"

# Redis (reserved for v1.5 intent caching — not consumed by v1 code)
REDIS_URL="redis://localhost:6379"

# Typesense
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"
TYPESENSE_API_KEY="xyz"

# Claude API (intent parsing)
ANTHROPIC_API_KEY=""
INTENT_MODEL="claude-opus-4-8"

# Gemini (free-tier alternative for intent parsing during dev).
# Get a key at https://aistudio.google.com/apikey
# Used automatically when GEMINI_API_KEY is set and ANTHROPIC_API_KEY is empty,
# or force with INTENT_PROVIDER=gemini|anthropic.
GEMINI_API_KEY=""
GEMINI_INTENT_MODEL="gemini-2.5-flash"
# INTENT_PROVIDER=""

# AccessTrade
ACCESSTRADE_TOKEN=""
# OPTIONAL — leave empty. The /v1/datafeeds API works and is the default path
# (verified: domain=shopee.vn returns ~12.9k products). This was intended as a
# bulk shortcut around the 30 req/min limit, but AccessTrade's publisher UI does
# not reliably expose a CSV export link. Only set this if you actually find a
# CSV export for your campaign; otherwise ingestion uses the throttled API.
ACCESSTRADE_CSV_URL=""

# Secret shared with n8n for /api/internal/ingest/* (send as x-ingest-secret header)
INGEST_SECRET=""

# Salt for hashing IPs before logging (PDPL: no raw PII in logs)
IP_HASH_SALT="change-me"

# Public origin, used to build absolute /go URLs if needed
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Header promo banner (Shopee sale event / Highlands Coffee / The Coffee House)
# — AccessTrade deep links, format:
# https://go.isclix.com/deep_link/<publisher_id>/<campaign_id>?url=<encoded target>
# Leave empty to hide a tile; /go/b/<slug> 404s when unset (fails closed).
BANNER_SHOPEE_URL=""
BANNER_HIGHLANDS_URL=""
BANNER_TCH_URL=""

# "Tạo link" tab (POST /api/link): AccessTrade publisher id + campaign id per
# marketplace, used to compose deep links in the format above. A merchant whose
# campaign var is empty is rejected (fails closed); publisher id empty disables
# the feature entirely.
ACCESSTRADE_PUBLISHER_ID=""
DEEPLINK_CAMPAIGN_SHOPEE=""
DEEPLINK_CAMPAIGN_LAZADA=""
DEEPLINK_CAMPAIGN_TIKTOK=""

# Service referrals (chat answers ticket/booking needs with a tracked merchant
# card — SERVICE_MERCHANTS in lib/config.ts). Value = AccessTrade campaign id;
# empty hides the merchant and /go/s/<slug> 404s (fails closed). Campaign ids
# from /v1/campaigns (2026-07-26): vexere 5222734619328835827,
# gotadi 4348614230663030600, atadi 4420497792266085742,
# klookvn 4704521809526929067 — verify approval on your own account first.
SERVICE_CAMPAIGN_VEXERE=""
SERVICE_CAMPAIGN_GOTADI=""
SERVICE_CAMPAIGN_ATADI=""
SERVICE_CAMPAIGN_KLOOK=""
