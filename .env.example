# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deal_finder"

# Redis (reserved for v1.5 intent caching — not consumed by v1 code)
REDIS_URL="redis://localhost:6379"

# Typesense
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"
TYPESENSE_API_KEY="xyz"

# Claude API (intent parsing)
ANTHROPIC_API_KEY=""
INTENT_MODEL="claude-opus-4-8"

# Gemini (free-tier alternative for intent parsing during dev).
# Get a key at https://aistudio.google.com/apikey
# Used automatically when GEMINI_API_KEY is set and ANTHROPIC_API_KEY is empty,
# or force with INTENT_PROVIDER=gemini|anthropic.
GEMINI_API_KEY=""
GEMINI_INTENT_MODEL="gemini-2.5-flash"
# INTENT_PROVIDER=""

# AccessTrade
ACCESSTRADE_TOKEN=""
# OPTIONAL — leave empty. The /v1/datafeeds API works and is the default path
# (verified: domain=shopee.vn returns ~12.9k products). This was intended as a
# bulk shortcut around the 30 req/min limit, but AccessTrade's publisher UI does
# not reliably expose a CSV export link. Only set this if you actually find a
# CSV export for your campaign; otherwise ingestion uses the throttled API.
ACCESSTRADE_CSV_URL=""

# Secret shared with n8n for /api/internal/ingest/* (send as x-ingest-secret header)
INGEST_SECRET=""

# Salt for hashing IPs before logging (PDPL: no raw PII in logs)
IP_HASH_SALT="change-me"

# Public origin, used to build absolute /go URLs if needed
NEXT_PUBLIC_APP_URL="http://localhost:3000"
